rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    
    function isValidProfile(data) {
      return data.full_name is string && data.full_name.size() > 0 && data.full_name.size() <= 100
          && data.email == request.auth.token.email;
    }

    function isValidCourse(data) {
      return data.mentor_id == request.auth.uid
          && data.title is string && data.title.size() <= 200
          && data.category is string
          && data.price is number && data.price >= 0
          && data.type in ['online', 'offline']
          && (data.image_url == null || data.image_url is string);
    }

    // --- Collection Rules ---

    // Profiles
    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isOwner(userId) && isValidProfile(incoming());
      allow update: if isVerified() && isOwner(userId) && isValidProfile(incoming())
                   && incoming().diff(existing()).affectedKeys().hasOnly(['full_name', 'bio', 'whatsapp_no', 'portfolio_links', 'image_url']);
    }

    // Courses
    match /courses/{courseId} {
      allow read: if true; // Public directory
      allow list: if true;
      
      allow create: if isVerified() && isValidCourse(incoming()) && incoming().is_active == true;
      
      allow update: if isVerified() && isOwner(existing().mentor_id) && isValidCourse(incoming())
                   && (
                     // Action: Toggle Active
                     (incoming().diff(existing()).affectedKeys().hasOnly(['is_active', 'updated_at'])) ||
                     // Action: Edit Details
                     (incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'price', 'type', 'location_city', 'image_url', 'updated_at']))
                   );
                   
      allow delete: if isVerified() && isOwner(existing().mentor_id);

      // Reviews Subcollection
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn() 
                     && incoming().rating is int && incoming().rating >= 1 && incoming().rating <= 5
                     && incoming().course_id == courseId;
      }
    }
  }
}
